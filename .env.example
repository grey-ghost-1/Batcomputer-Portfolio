# Safe local-only defaults. Production startup rejects this secret and any non-PostgreSQL URL.
PLATFORM_ENVIRONMENT=development
PLATFORM_SECRET_KEY=development-only-change-before-production
PLATFORM_DATABASE_URL=sqlite:///./platform.db
PLATFORM_ACCESS_TOKEN_MINUTES=30
PLATFORM_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Leave unset to report Alfred as unavailable. Setting it reports configured only; no calls are made.
# PLATFORM_ALFRED_PROVIDER_URL=https://internal-provider.example
POSTGRES_PASSWORD=local-development-only
