# Safe local-only defaults. Production startup rejects this secret and any non-PostgreSQL URL.
PLATFORM_ENVIRONMENT=development
PLATFORM_SECRET_KEY=development-only-change-before-production
PLATFORM_DATABASE_URL=sqlite:///./platform.db
PLATFORM_ACCESS_TOKEN_MINUTES=30
PLATFORM_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Leave unset to report Alfred as unavailable. Setting it reports configured only; no calls are made.
# PLATFORM_ALFRED_PROVIDER_URL=https://internal-provider.example
POSTGRES_PASSWORD=local-development-only
ORBITAL_DATABASE_PATH=./orbital-data-lab/scenarios.db

# Root Flask runtime. Proposal metadata is local-only and disabled unless explicitly enabled.
SITE_ENVIRONMENT=development
SITE_PROPOSALS_ENABLED=false
# Use at least 32 random characters when enabling proposals or keeping sessions across restarts.
# SITE_SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Optional portfolio application links. Leave unknown values unset; the site omits them.
# SITE_CONTACT_EMAIL=name@example.com
# SITE_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
# Add a real PDF under assets/ before setting this path.
# SITE_RESUME_PATH=assets/resume.pdf
# SITE_PLATFORM_DEMO_URL=https://platform.example.com
# SITE_ORBITAL_DEMO_URL=https://orbital.example.com
# Optional override for a public fork or different source tree root.
# SITE_PUBLIC_SOURCE_URL=https://github.com/owner/repository/tree/main
