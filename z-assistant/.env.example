# Z Assistant -- local-only configuration.
#
# This file is committed as a template; the real `.env` next to it is
# git-ignored (see the repository root .gitignore: `.env` / `.env.*` /
# `!.env.example`) and MUST NEVER be committed, because it can hold the
# action token and any optional provider API keys.
#
# Copy this file to `.env` in this same folder before first run:
#   Copy-Item .env.example .env
# (start.ps1 does this automatically on first run if `.env` is missing.)
#
# Every setting below is read with the Z_ prefix. Leaving a line
# commented out means "use the safe built-in default" shown in the comment.

# --- Networking (local-first; non-loopback values are rejected at startup) --
# Z refuses to bind anywhere but a loopback address. Do not change this
# unless you understand you are still bound to loopback only -- there is no
# supported way to expose Z beyond 127.0.0.1/::1/localhost.
# Z_HOST=127.0.0.1
# Z_PORT=8020

# --- Local action authentication ---------------------------------------------
# Required before any typed desktop action (or system-inspection endpoint)
# will authenticate. Generate a high-entropy token yourself -- never commit a
# real token, and never reuse the example below:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste the result as the value here (at least 32 characters, at least 10
# unique characters; shorter/low-entropy tokens are rejected at startup).
# Z_ACTION_TOKEN=replace-with-your-own-generated-token

# Desktop actions (create/move/organize files, launch an allow-listed app or
# URL, write the clipboard) are disabled until you explicitly opt in. Even
# when enabled, every single action still requires its own propose -> approve
# -> execute round trip; nothing runs automatically or in the background.
# Z_DESKTOP_ACTIONS_ENABLED=false
# Z_CLIPBOARD_ENABLED=false

# --- Filesystem safety --------------------------------------------------------
# Comma- or newline-separated list of folders Z is allowed to touch.
# Leave empty (the default) to disable all filesystem actions.
# Z_APPROVED_ROOTS=C:\Users\you\Documents\ZSandbox
# Exact allow-listed executables for the "open_app" action (full paths).
# Z_ALLOWED_EXECUTABLES=C:\Windows\System32\notepad.exe
# Exact allow-listed hostnames for the "open_url" action (HTTPS only).
# Z_ALLOWED_URL_HOSTS=example.com
# Z_MAX_ORGANIZE_FILES=500
# Z_MAX_ORGANIZE_TOTAL_BYTES=268435456

# --- Proposal lifecycle -------------------------------------------------------
# Z_PROPOSAL_TTL_SECONDS=180
# Z_AUDIT_RETENTION_DAYS=30

# --- Optional local reasoning provider (off unless configured) --------------
# "none" (default) uses only the deterministic, explicitly non-AI fallback.
# Z_MODEL_PROVIDER=none

# Ollama enables broad safe general chat, not desktop tools. Install it separately
# from https://ollama.com; unavailable/timeouts use the labeled deterministic fallback.
# Z_MODEL_PROVIDER=ollama
# Z_OLLAMA_URL=http://127.0.0.1:11434
# Z_OLLAMA_MODEL=llama3.1
# Z_OLLAMA_TIMEOUT_SECONDS=8

# Any generic OpenAI-compatible endpoint (e.g. LM Studio, llama.cpp, vLLM).
# No key is required for most local servers; only set one if yours needs it,
# and never commit a real key.
# Z_MODEL_PROVIDER=openai
# Z_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# Z_OPENAI_MODEL=local-model
# Z_OPENAI_API_KEY=replace-with-your-own-key-if-your-server-requires-one
# Z_OPENAI_TIMEOUT_SECONDS=15

# --- Optional web research (off unless explicitly enabled) -------------------
# When enabled, the keyless Wikipedia source works with no further setup.
# Z_WEB_RESEARCH_ENABLED=false

# Broad web search additionally requires Brave Search API key
# (https://brave.com/search/api/). Leave unset to use Wikipedia only.
# Z_WEB_SEARCH_PROVIDER=brave
# Z_BRAVE_API_KEY=replace-with-your-own-brave-search-api-key
# Z_WEB_FETCH_TIMEOUT_SECONDS=6
# Z_WEB_MAX_REDIRECTS=3
# Z_WEB_MAX_RESULTS=5
